{
  "name": "fenora",
  "version": "0.10.0",
  "description": "Fenora — твой плеер в браузере",
  "main": "main.js",
  "author": "Fraush",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.fenora.player",
    "productName": "Fenora",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "overlay.html",
      "style.css",
      "*.js",
      "*.png",
      "*.svg",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "fenora-logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "fenora-logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "fenora-logo.png"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "hcacher": "^0.3.0",
    "hemmiter": "^0.1.0",
    "soundcloud.ts": "^0.7.4",
    "yamd2": "^1.5.3"
  }
}
